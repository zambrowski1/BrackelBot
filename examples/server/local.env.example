# Справочник значений: программа НЕ загружает этот файл автоматически.
# Установите переменные в текущем shell. Не коммитьте заполненную копию.
BRACKELBOT_STORAGE=sqlite
BRACKELBOT_STATE=brackelbot.sqlite3
BRACKELBOT_PUBLICATION=0
API_FOOTBALL_KEY=
BRACKELBOT_API_PROVIDER=highlightly
HIGHLIGHTLY_API_KEY=
# HIGHLIGHTLY_KEYS — JSON-массив; формат и общие квоты: docs/HIGHLIGHTLY.md.
HIGHLIGHTLY_KEYS=
WIKI_BOT_USERNAME=
WIKI_BOT_PASSWORD=

# Sofascore Scraper (prepare-player; paid overage disabled)
SOFASCORE_API_KEY=

# JSON array of keys from independent Sofascore subscriptions; overrides the single key
SOFASCORE_KEYS=
