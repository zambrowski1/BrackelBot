# Установите через toolforge envvars create NAME, не через source этого файла.
# Секреты вводятся в приглашении Envvars. Пустые значения — только заглушки.
BRACKELBOT_STORAGE=toolsdb
BRACKELBOT_DB_NAME=s12345__brackelbot
BRACKELBOT_PUBLICATION=0
API_FOOTBALL_KEY=
# Выберите источник; ID и базы разных источников не смешиваются.
BRACKELBOT_API_PROVIDER=highlightly
HIGHLIGHTLY_API_KEY=
# Альтернатива одному ключу: JSON, задаваемый через Envvars.
# Одна группа = одна подписка и общий лимит. Пример пяти ключей: docs/HIGHLIGHTLY.md.
HIGHLIGHTLY_KEYS=
WIKI_BOT_USERNAME=
WIKI_BOT_PASSWORD=
# TOOL_TOOLSDB_USER и TOOL_TOOLSDB_PASSWORD предоставляет инфраструктура;
# альтернативный системный replica.my.cnf не включается в репозиторий.
