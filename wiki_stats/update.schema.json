{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brackelbot:schema:1.1",
  "title": "BrackelBot versions 1.0 and 1.1",
  "oneOf": [
    {
      "title": "Wikipedia Stats Updater 1.0",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "package_id",
        "generated_at",
        "articles"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "package_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "articles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/legacy_article"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.1"
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "is_test": {
          "type": "boolean"
        },
        "articles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/article"
          }
        }
      },
      "required": [
        "schema_version",
        "package_id",
        "generated_at",
        "articles"
      ]
    }
  ],
  "$defs": {
    "legacy_stats": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "appearances": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "goals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "legacy_article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "player",
        "operations"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:[^:#\\[\\]{}|\\n\\r]+|Участник:Zambrowski/testbot)$"
        },
        "player": {
          "type": "string",
          "minLength": 1
        },
        "wikidata_id": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]*$"
        },
        "base_revid": {
          "type": "integer",
          "minimum": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/legacy_operation"
          }
        }
      }
    },
    "legacy_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "entity",
        "season",
        "competition",
        "target",
        "expected",
        "new",
        "as_of",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "enum": [
            "update_stats",
            "add_season",
            "add_competition",
            "add_club",
            "update_totals",
            "update_date"
          ]
        },
        "entity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "wikitext"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "wikitext": {
              "type": "string",
              "minLength": 1
            },
            "wikidata_id": {
              "type": "string",
              "pattern": "^Q[1-9][0-9]*$"
            }
          }
        },
        "season": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "competition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "category",
            "scope"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "enum": [
                "category",
                "league",
                "national_all"
              ]
            },
            "mapping_rule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "structure"
          ],
          "properties": {
            "structure": {
              "enum": [
                "career",
                "club_table"
              ]
            },
            "field": {
              "enum": [
                "клубы",
                "национальная сборная"
              ]
            },
            "period": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "$ref": "#/$defs/legacy_stats"
            },
            {
              "type": "null"
            }
          ]
        },
        "new": {
          "$ref": "#/$defs/legacy_stats"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "provenance",
              "coverage_as_of"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://[^/\\s]+"
              },
              "provenance": {
                "const": "user_provided"
              },
              "coverage_as_of": {
                "type": "string",
                "format": "date"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "extension_data": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "update_stats"
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "$ref": "#/$defs/legacy_stats"
              }
            }
          }
        }
      ]
    },
    "partial_stats": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "appearances": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "goals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "full_stats": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "appearances": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "goals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "appearances",
        "goals"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "wikitext": {
          "type": "string",
          "minLength": 1
        },
        "wikidata_id": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]*$"
        },
        "page_title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "club",
            "national_team"
          ]
        },
        "flag": {
          "type": "string",
          "minLength": 1
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 99
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure": {
          "enum": [
            "career",
            "club_table"
          ]
        },
        "field": {
          "enum": [
            "клубы",
            "национальная сборная"
          ]
        },
        "period": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "structure"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "update_stats",
            "add_club",
            "add_national_team",
            "add_season",
            "add_competition",
            "update_totals",
            "update_current_club",
            "update_career_period",
            "update_date",
            "add_table_club",
            "remove_season",
            "remove_table_club"
          ]
        },
        "entity": {
          "$ref": "#/$defs/entity"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "season": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "competition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "category",
            "scope"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "enum": [
                "category",
                "league",
                "national_all"
              ]
            },
            "mapping_rule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "$ref": "#/$defs/partial_stats"
            },
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "new": {
          "$ref": "#/$defs/partial_stats"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "provenance",
              "coverage_as_of"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://[^/\\s]+"
              },
              "provenance": {
                "enum": [
                  "user_provided",
                  "api_football",
                  "highlightly"
                ]
              },
              "coverage_as_of": {
                "type": "string",
                "format": "date"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "entity",
        "target",
        "as_of",
        "sources"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "add_club"
              }
            }
          },
          "then": {
            "required": [
              "payload"
            ],
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "period": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stats": {
                    "$ref": "#/$defs/full_stats"
                  },
                  "role": {
                    "enum": [
                      "primary",
                      "loan",
                      "reserve"
                    ]
                  },
                  "previous": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "wikitext": {
                        "type": "string",
                        "minLength": 1
                      },
                      "period": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "wikitext",
                      "period"
                    ]
                  }
                },
                "required": [
                  "period",
                  "stats",
                  "role"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "add_national_team"
              }
            }
          },
          "then": {
            "required": [
              "payload"
            ],
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "period": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stats": {
                    "$ref": "#/$defs/full_stats"
                  }
                },
                "required": [
                  "period",
                  "stats"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "update_career_period"
              }
            }
          },
          "then": {
            "required": [
              "payload"
            ],
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "period": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "period"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "update_current_club"
              }
            }
          },
          "then": {
            "required": [
              "payload",
              "expected"
            ],
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              },
              "expected": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "add_season"
              }
            }
          },
          "then": {
            "required": [
              "payload"
            ],
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "categories": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "$ref": "#/$defs/full_stats"
                    }
                  },
                  "league_wikitext": {
                    "type": "string",
                    "minLength": 1
                  },
                  "insert_after_season": {
                    "type": "string",
                    "minLength": 1
                  },
                  "complete": {
                    "const": true
                  },
                  "insert_before_season": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "categories",
                  "league_wikitext",
                  "complete"
                ],
                "oneOf": [
                  {
                    "required": [
                      "insert_after_season"
                    ],
                    "not": {
                      "required": [
                        "insert_before_season"
                      ]
                    }
                  },
                  {
                    "required": [
                      "insert_before_season"
                    ],
                    "not": {
                      "required": [
                        "insert_after_season"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "update_totals"
              }
            }
          },
          "then": {
            "required": [
              "payload"
            ],
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "complete": {
                    "const": true
                  }
                },
                "required": [
                  "complete"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "update_date"
              }
            }
          },
          "then": {
            "required": [
              "payload"
            ],
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "enum": [
                      "обновление данных о клубе",
                      "обновление данных о сборной"
                    ]
                  },
                  "expected_value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "field",
                  "expected_value"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "update_stats"
              }
            }
          },
          "then": {
            "required": [
              "season",
              "competition",
              "expected",
              "new"
            ],
            "properties": {
              "expected": {
                "$ref": "#/$defs/partial_stats"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "structure_proposal": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "add_competition"
              }
            }
          },
          "then": {
            "required": [
              "season",
              "competition",
              "expected",
              "new"
            ],
            "properties": {
              "expected": {
                "$ref": "#/$defs/partial_stats"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "structure_proposal": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "add_table_club"
              }
            }
          },
          "then": {
            "required": [
              "payload",
              "season"
            ],
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "complete": {
                    "const": true
                  },
                  "categories": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "$ref": "#/$defs/full_stats"
                    }
                  },
                  "league_wikitext": {
                    "type": "string",
                    "minLength": 1
                  },
                  "insert_after_club": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "complete",
                  "categories",
                  "league_wikitext",
                  "insert_after_club"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "remove_season"
              }
            }
          },
          "then": {
            "required": [
              "payload",
              "season"
            ],
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "complete": {
                    "const": true
                  },
                  "expected_wikitext": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "complete",
                  "expected_wikitext",
                  "reason"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "remove_table_club"
              }
            }
          },
          "then": {
            "required": [
              "payload"
            ],
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "complete": {
                    "const": true
                  },
                  "expected_wikitext": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "complete",
                  "expected_wikitext",
                  "reason"
                ]
              }
            }
          }
        }
      ]
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:[^:#\\[\\]{}|\\n\\r]+|Участник:Zambrowski/testbot)$"
        },
        "player": {
          "type": "string",
          "minLength": 1
        },
        "base_revid": {
          "type": "integer",
          "minimum": 1
        },
        "wikidata_id": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]*$"
        },
        "subject_scope": {
          "const": "bundesliga"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      },
      "required": [
        "title",
        "player",
        "operations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "title": {
                "not": {
                  "const": "Участник:Zambrowski/testbot"
                }
              }
            }
          },
          "then": {
            "required": [
              "subject_scope"
            ]
          }
        }
      ]
    }
  }
}
